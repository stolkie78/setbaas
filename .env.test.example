# SetBaas Test Environment
# Copy to .env.test and fill in your values:
#   cp .env.test.example .env.test
#
# Then start everything with:
#   ./scripts/deploy.sh test

# Published ports on the host.
# Keep the frontend on 3000 + PocketBase on 8090: the browser client talks to
# PocketBase directly on 8090 when the app runs on port 3000.
TEST_HTTP_PORT=3000
TEST_PB_PORT=8090

# === PocketBase admin credentials (required) ===
PB_ADMIN_EMAIL=admin@setbaas.local
PB_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Account that gets admin access on every team during setup
OWNER_EMAIL=

# Built-in setbaas-admin account (narrow role). Leave blank to skip.
SETBAAS_ADMIN_EMAIL=
SETBAAS_ADMIN_PASSWORD=

# === Google OAuth (optional for test) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === SMTP (optional for test) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@setbaas.nl
