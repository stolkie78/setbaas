# SetBaas environment variables
# Copy to .env and fill in your values

# === Domain & SSL ===
# Your domain name (e.g. setbaas.nl, setbaas.local, localhost)
DOMAIN=localhost

# Enable HTTPS via Let's Encrypt (true/false)
# true  = Caddy requests SSL certificate automatically (needs port 80+443 open, public DNS)
# false = HTTP only (for local/LAN use)
ENABLE_SSL=false

# Full site URL (include https:// or http:// matching ENABLE_SSL)
SITE_URL=http://localhost

# Email of the account that should get admin access on every team during setup
OWNER_EMAIL=

# Built-in setbaas-admin account (narrow role): can only create new clubs and
# grant the first admin user to a freshly created club. Leave blank to skip.
SETBAAS_ADMIN_EMAIL=
SETBAAS_ADMIN_PASSWORD=

# HTTP port (default 80, change if port 80 is taken)
HTTP_PORT=80

# === PocketBase admin credentials (required for setup) ===
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# === Google OAuth (get from Google Cloud Console) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === SMTP (invitations, login codes, password resets, inbox notifications) ===
# Example for the SetBaas mail server:
#   SMTP_HOST=mail.setbaas.nl, SMTP_PORT=587 (STARTTLS) or 465 (TLS),
#   SMTP_USER=info@setbaas.nl, SMTP_FROM=info@setbaas.nl
# Re-run the setup (pb-setup) after changing these: PocketBase mails the
# login codes and password resets itself.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@setbaas.nl
