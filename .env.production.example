# SetBaas Production Environment
# Copy this to .env.production on your server, fill in real values, and never commit it.

# Domain
DOMAIN=setbaas.example.com

# Base path for SvelteKit (subpath deployment, leave empty for a dedicated domain)
BASE_PATH=

# Public PocketBase URL
PUBLIC_POCKETBASE_URL=https://setbaas.example.com/api

# Frontend origin
ORIGIN=https://setbaas.example.com

# PocketBase admin credentials
PB_ADMIN_EMAIL=admin@setbaas.example.com
PB_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Google OAuth (update redirect URI to https://setbaas.example.com/api/oauth2-redirect)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Full public site URL. Used by PocketBase for links in mails (password reset).
SITE_URL=https://setbaas.example.com

# Mail (invitations, login codes, password resets, inbox notifications).
# Port 587 = STARTTLS, 465 = TLS. Re-run the setup after changing these:
#   ./scripts/deploy.sh prod --setup
SMTP_HOST=mail.setbaas.nl
SMTP_PORT=587
SMTP_USER=info@setbaas.nl
SMTP_PASS=CHANGE_ME
SMTP_FROM=info@setbaas.nl

# Account that gets admin access on every team during setup
OWNER_EMAIL=owner@example.com

# Built-in setbaas-admin account (narrow role): can only create new clubs and
# grant the first admin user to a freshly created club. Leave blank to skip.
SETBAAS_ADMIN_EMAIL=
SETBAAS_ADMIN_PASSWORD=

# === Reverse proxy (apart beheerde Caddy-instantie) ===
# Map waar de centrale Caddy zijn drop-in site configs leest.
CADDY_CONF_DIR=/home/giedo/apps/caddy/conf.d
# Naam van de Caddy container. Leeg laten = automatisch detecteren.
CADDY_CONTAINER=
# Pad naar de hoofd-Caddyfile binnen die container.
CADDY_CONFIG_PATH=/etc/caddy/Caddyfile
